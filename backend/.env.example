# Application Settings
PORT=8000
ENVIRONMENT=development
# SQLite database file (default: data/aegis.db at the repo root). Use a fresh path
# for a clean demo, e.g. DATABASE_PATH=/tmp/aegis-demo/demo.db
# DATABASE_PATH=data/aegis.db
# Optional CartoDEM tile; download it yourself (data/terrain/README.md), never commit it.
# DEM_PATH=data/terrain/cdnd43d_v3r1/cdnd43d.tif
# OSM_GRAPH_PATH=data/osm/hubballi_dharwad_drive.graphml
# Inputs farther than this from the road network are rejected (OUTSIDE_COVERAGE).
# MAX_SNAP_DISTANCE_M=250
# Weather observations older than this are treated as STALE (unknown).
# WEATHER_MAX_AGE_MINUTES=90

# IMD National Weather Settings
IMD_API_BASE_URL=https://api.imd.gov.in/api
# Leave empty unless you hold IMD access; a non-empty value enables live IMD calls.
IMD_API_KEY=
DEMO_MODE=true
NATIONAL_CACHE_TTL_SECONDS=300

# Satellite & Hazard APIs
MOSDAC_API_KEY=
FIRMS_API_KEY=
